# Copy this file to .env and replace every placeholder before starting the API.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=REPLACE_WITH_OUTPUT_OF_SECRET_GENERATOR
ACCESS_TOKEN_MINUTES=30

# File-backed SaaS authentication. No SQL database is used.
# Create the first Super Admin offline while the API is stopped:
# python scripts/saas_admin.py bootstrap-super-admin --username YOUR_USERNAME
# Optional: defaults to data/users.json
# AUTH_USERS_FILE=data/users.json

# Data storage defaults to the repository's data/ folder.
# Set these to durable, private storage paths in deployment.
# SMART_CAMPUS_DATA_DIR=
# AUTH_USERS_FILE=

# Upload limits default to 10 MB and 20,000 rows.
IMPORT_MAX_UPLOAD_MB=10
IMPORT_MAX_ROWS=20000
# Optional: defaults to a private temporary folder under the OS temp directory.
# IMPORT_STORAGE_DIR=

# Frontend development URLs; set CORS_ORIGINS to the exact deployed frontend origin(s) in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Optional AI assistant powered by Groq. Keep this key server-side only.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=45
